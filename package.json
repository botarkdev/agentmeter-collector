{
  "name": "@agentmeter/collector",
  "version": "0.2.0",
  "description": "Reads a coding agent's local usage logs and reports token counts to agentmeter, without ever blocking or failing the session that produced them.",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "agentmeter": "dist/cli/agentmeter.js"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:cov": "vitest run --config vitest.unit.config.ts --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write \"**/*.{ts,mts,cts,js,mjs,cjs,json}\"",
    "format:check": "prettier --check \"**/*.{ts,mts,cts,js,mjs,cjs,json}\"",
    "check:package": "node scripts/check-package.mjs",
    "prepack": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.10",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/botarkdev/agentmeter-collector.git"
  },
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "NOTICE"
  ]
}
